# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=netguard_ai

# Model artifacts (default: repo ml/artifacts)
NETGUARD_ARTIFACT_DIR=

# Alerts: email when attack + confidence >= threshold
ALERT_CONFIDENCE_THRESHOLD=0.90
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true

# IP blocking API (required header: Authorization: Bearer <key>)
BLOCK_API_KEY=change-me-in-production

# Never block RFC1918/link-local unless true (lab only)
ALLOW_BLOCK_PRIVATE=false

# Comma-separated IPs that can never be blocked
WHITELIST_IPS=127.0.0.1,::1

# CORS for React dev server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Training
EDGE_IIOTSET_CSV=

# Frontend (local dev): leave empty to use Vite proxy
VITE_API_BASE=
VITE_BLOCK_API_KEY=change-me-in-production
